# Email send connection (data-access)
SMTP_HOST=                      # SMTP provider
SMTP_PORT=                      # SMTP provider port (587 for TLS, 465 for SSL)
SMTP_USER=                      # SMTP user email address
SMTP_PASS=                      # App Password (not your email password) for the SMTP user email address
SMTP_FROM="Aftermath" <noreply@aftermath.app>
FRONTEND_URL=http://localhost:5173

